[Unit]
Description=Attic PostgreSQL Database
After=network-online.target

[Container]
Image=docker.io/library/postgres:16-alpine
ContainerName=attic-db

Volume=/opt/attic/db:/var/lib/postgresql/data:Z

Environment=POSTGRES_DB=attic
Environment=POSTGRES_USER=attic
Secret=attic_db_password,type=env,target=POSTGRES_PASSWORD

Network=homelab

HealthCmd=pg_isready -U attic -d attic
HealthInterval=30s
HealthRetries=5
HealthStartPeriod=20s
HealthTimeout=5s

[Service]
Restart=always
RestartSec=10

[Install]
WantedBy=default.target
